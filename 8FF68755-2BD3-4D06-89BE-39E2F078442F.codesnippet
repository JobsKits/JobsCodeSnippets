	<key>IDECodeSnippetContents</key>
	<string>#if __has_include(&lt;JobsBlock/JobsBlock.h&gt;)
#import &lt;JobsBlock/JobsBlock.h&gt;
#else
#import "JobsBlock.h"
#endif

#if __has_include(&lt;JobsOCDefs/JobsDefines.h&gt;)
#import &lt;JobsOCDefs/JobsDefines.h&gt;
#else
#import "JobsDefines.h"
#endif

-(&lt;#JobsBlockType#&gt; _Nonnull)&lt;#methodName#&gt;{
    @jobs_weakify(self)
    return ^(&lt;#void_or_ParameterType _Nullable value#&gt;) {
        @jobs_strongify(self)
        if (!self) return;
        &lt;#OriginalMethodBody#&gt;
    };
}</string>
	<key>IDECodeSnippetIdentifier</key>
	<string>8FF68755-2BD3-4D06-89BE-39E2F078442F</string>
